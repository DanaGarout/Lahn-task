# Copy this file to .env (for local dev) and/or .env.production (for a real deploy)
# Never commit the real .env file — it is already ignored in .gitignore.

# Base URL of the Events backend API.
# - For local development against the bundled demo mock server: http://localhost:4000/api
# - For the real company-provided backend: replace with the real base URL, e.g. https://api.company.com/v1
VITE_API_BASE_URL=http://localhost:4000/api

# Port the bundled Express mock server listens on (only used by mock-server/server.js).
MOCK_SERVER_PORT=4000
