# Copy this file to .env and adjust if needed.
# Never commit the real .env file — it is already ignored in .gitignore.

# Base URL of the Events Assessment API (see https://dana-test-project.lahn.sa/api-docs/).
# Note it includes the /api/v1 version prefix — every endpoint path in src/api/*
# is written relative to this (e.g. "/public/events", "/auth/login").
VITE_API_BASE_URL=https://dana-test-project.lahn.sa/api/v1
